# ==============================================================================
# Configurazione REDCap API (Ospedale Valduce)
# ==============================================================================
REDCAP_API_URL=https://redcap.valduce.it/redcap/api/
REDCAP_API_TOKEN=YOUR_REDCAP_API_TOKEN_HERE

# ==============================================================================
# Configurazione IA Locale: llama.cpp con Inferenza Distribuita (RPC su 2 Schede)
# ==============================================================================
AI_BACKEND=llama_cpp
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_API_MODE=chat
LLAMA_CPP_MODEL=llama-cpp-rpc
LLAMA_CPP_TEMPERATURE=0.0
LLAMA_CPP_TIMEOUT_SECONDS=180

# Fallback opzionale Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ==============================================================================
# Configurazione Priamo .NET API (Ospedale Valduce)
# ==============================================================================
CLOUDFLARED_CLIENT_ID=YOUR_CLOUDFLARE_CLIENT_ID.access
CLOUDFLARED_CLIENT_SECRET=YOUR_CLOUDFLARE_CLIENT_SECRET
PRIAMO_API_URL=https://priamo-home.valduce.it:8062
PRIAMO_USERNAME=YOUR_USERNAME
PRIAMO_PASSWORD=YOUR_PASSWORD

# ==============================================================================
# Opzioni e Percorsi Predefiniti
# ==============================================================================
DEFAULT_FORM_NAME=radiologia
PATIENTS_EXCEL_PATH=/home/dennis/PycharmProjects/PriamoScraper/files/interventi.xls
