# ==============================================================================
# Configurazione REDCap API (Ospedale Valduce)
# ==============================================================================
REDCAP_API_URL=https://redcap.valduce.it/redcap/api/
REDCAP_API_TOKEN=YOUR_REDCAP_API_TOKEN_HERE

# ==============================================================================
# Configurazione IA Locale: llama.cpp con Inferenza Distribuita (RPC su 2 Schede)
# ==============================================================================
AI_BACKEND=llama_cpp
LLAMA_CPP_BASE_URL=http://localhost:8080
LLAMA_CPP_API_MODE=chat
LLAMA_CPP_MODEL=llama-cpp-rpc
LLAMA_CPP_TEMPERATURE=0.0
LLAMA_CPP_TIMEOUT_SECONDS=180

# Fallback opzionale Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ==============================================================================
# Configurazione Priamo .NET API (Ospedale Valduce / Cloudflare Tunnel)
# ==============================================================================
PRIAMO_CLOUDFLARED_CLIENT_ID=YOUR_PRIAMO_CLOUDFLARE_CLIENT_ID.access
PRIAMO_CLOUDFLARED_CLIENT_SECRET=YOUR_PRIAMO_CLOUDFLARE_CLIENT_SECRET
PRIAMO_API_URL=https://priamo-home.valduce.it:8062
PRIAMO_USERNAME=YOUR_USERNAME
PRIAMO_PASSWORD=YOUR_PASSWORD
PRIAMO_MAX_WORKERS=8

# ==============================================================================
# Configurazione Remota llama.cpp (Cloudflare Access)
# ==============================================================================
AI_CLOUDFLARED_CLIENT_ID=YOUR_AI_CLOUDFLARE_CLIENT_ID.access
AI_CLOUDFLARED_CLIENT_SECRET=YOUR_AI_CLOUDFLARE_CLIENT_SECRET

# ==============================================================================
# Opzioni e Percorsi Predefiniti
# ==============================================================================
DEFAULT_FORM_NAME=radiologia
PATIENTS_EXCEL_PATH=/path/to/interventi.xls

# ==============================================================================
# Sicurezza & Server HTTP (FastAPI)
# ==============================================================================
# API_HOST=127.0.0.1
# SENONETWORK_API_KEY=sn_your_generated_api_key_here
# ALLOW_INSECURE_LOCAL_DEV=false
# ALLOW_MASS_DELETE=false
# REDCAP_DELETE_TOKEN=
# PRIAMO_VERIFY_SSL=true
# AI_MAX_CONCURRENT_REQUESTS=1
# LLM_FALLBACK_TIMEOUT_SECONDS=30
